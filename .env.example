# ============================================================================
#  Polymarket Constellation 多资产策略  --  配置示例
#  用法：复制本文件为 .env 并填写。除 PRIVATE_KEY 外，其余均已有合理默认值。
#  详见 README.md
# ============================================================================

# --- 钱包 / 鉴权 ------------------------------------------------------------
# 【必填】你的钱包私钥（0x 开头）。切勿泄露、切勿提交到 git。
PRIVATE_KEY=

# 资金所在地址（funder）。留空 = 使用私钥对应的地址（EOA 直连场景）。
# 若你用邮箱/Google(Magic) 或浏览器钱包登录 Polymarket，资金在“代理钱包”里，
# 请在 polymarket.com 的 Deposit 页面复制该地址填到这里。
FUNDER_ADDRESS=

# 签名类型：auto / 0 / 1 / 2 / 3
#   0 = EOA（私钥地址即资金地址，MetaMask 直连）
#   1 = POLY_PROXY（邮箱/Google Magic 代理钱包）
#   2 = GNOSIS_SAFE（浏览器钱包代理，旧架构）
#   3 = DEPOSIT_WALLET（2026-05-04 之后的新账号 / EIP-1271）
# auto = 链上自动判断（funder 为空或等于私钥地址 -> 0；是 Gnosis Safe -> 2；否则 -> 1）
# 若下单报 "maker address not allowed, please use the deposit wallet flow"，改成 3。
SIGNATURE_TYPE=auto

# --- 运行模式 ---------------------------------------------------------------
# 模拟模式：true = 只打印信号与将要下的单，不花真钱。确认无误后再改 false。
DRY_RUN=true

# 下单失败后的重试（网络抖动 / 盘口暂时无卖单时，会重新检查条件后重试）
# 每个窗口每个资产最多尝试下单次数（含首次），达到后放弃
ORDER_RETRY_MAX_ATTEMPTS=5
# 两次尝试之间的最小间隔（秒），避免高频刷单
ORDER_RETRY_INTERVAL_SECONDS=1.0

# --- 市场 -------------------------------------------------------------------
# 仅用于缺省/兼容；Constellation 逐资产构造 slug，不依赖这两项
ASSET=btc
TIMEFRAME=5m

# --- 价格源 -----------------------------------------------------------------
# chainlink_twap（官方结算源，推荐） 或 chainlink（现货） 或 binance
PRICE_SOURCE=chainlink_twap
# TWAP 窗口（秒），官方用 60
TWAP_WINDOW_SECONDS=60

# --- 目标价 -----------------------------------------------------------------
# window_open = 用窗口开盘瞬间的价格作为目标价（推荐）
# manual      = 使用下方 MANUAL_TARGET 的固定值
TARGET_MODE=window_open
MANUAL_TARGET=

# ============================================================================
#  Constellation 参数（默认取 KumiBot 官网公开规则，可按需覆盖）
# ============================================================================

# 标的（逗号分隔）
CONSTELLATION_ASSETS=btc,eth,sol,xrp,doge,bnb

# 信号参数（默认照官网 BALANCED 预设）
# 涨跌幅大于该值记为「跟涨」，小于负值记为「跟跌」（百分比）
CONSTELLATION_MOVE_PCT=0.03
# 队伍平均涨幅门槛（近似官网 UP/DOWN threshold）：跟风资产的平均涨幅须 ≥ 该值。
# 0 = 关闭（只用逐资产 MOVE_PCT）。回测 0.05 胜率/ROI/回撤略优于 0。
CONSTELLATION_MIN_AVG_MOVE_PCT=0.05
# 隐含概率差（laggard gap）：落后者的盘口价，要比「跟风队伍」的均价至少低该值，
# 才算值得下注的真落后者（官网口径，0~1）
CONSTELLATION_LAGGARD_GAP=0.15
# 同向资产数达到该值才算共识（6 选 4）
CONSTELLATION_MIN_CONSENSUS=4
# BTC 过去 1 小时涨/跌达到该幅度，放松逆向一侧的共识要求（百分比）
CONSTELLATION_BTC_REVERSION_PCT=2.0
# 放松的共识数量
CONSTELLATION_REVERSION_RELAX=1
# 入场价格带：落后者对应侧盘口价需落在 [min,max]
CONSTELLATION_ENTRY_MIN=0.38
CONSTELLATION_ENTRY_MAX=0.68
# 共识扫描在本窗口开始后多少秒启动（官网 T+90s）
CONSTELLATION_SCAN_AFTER_SECONDS=90

# 三步入场 DCA
CONSTELLATION_DCA_START_USD=5
# 价格每下滑多少触发一次加仓
CONSTELLATION_DCA_STEP=0.09
# 第 1 次下滑加仓 / 第 2 次下滑加仓
CONSTELLATION_DCA_ADD2_USD=3
CONSTELLATION_DCA_ADD3_USD=2.5
# 单笔（单资产）累计上限
CONSTELLATION_DCA_MAX_USD=10.5
# 收盘前多少秒停止加仓
CONSTELLATION_DCA_STOP_BEFORE_CLOSE=110

# 风险上限
CONSTELLATION_MAX_POSITIONS=3
CONSTELLATION_MAX_EXPOSURE_USD=31.5

# 交易时段（UTC 小时），如 "9-17"、"0-8,13-23"；留空 = 全天
CONSTELLATION_TRADING_HOURS_UTC=

# --- 高级 / 一般无需修改 -----------------------------------------------------
CLOB_HOST=https://clob.polymarket.com
GAMMA_HOST=https://gamma-api.polymarket.com
RTDS_URL=wss://ws-live-data.polymarket.com
CHAIN_ID=137
POLYGON_RPC=https://polygon-rpc.com
LOG_DIR=logs
LOG_LEVEL=INFO

# 目标价容差（毫秒）：启动时若最早的历史 tick 晚于窗口开盘超过该值，则放弃本窗口
TARGET_TOLERANCE_MS=5000
